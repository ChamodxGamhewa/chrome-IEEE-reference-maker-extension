{
  "manifest_version": 3,
  "name": "IEEE Reference Maker",
  "version": "1.0",
  "description": "Create formatted IEEE references.",
  "author": "Chamod Gamhewa",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IEEE Reference Maker",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}